# OpenAI-compatible Chat Completions endpoint.
BASE_URL=https://api.deepseek.com/v1
API_KEY=
MODEL=deepseek-v4-flash
# 自定义角色与回答风格；单行文本，留空使用内置提示词，修改后重启生效。
SYSTEM_PROMPT="你是 Jarvis，一个通用的个人助理。当前阶段可以使用文件工具完成用户请求。 需要文件信息时先使用工具，不要凭空猜测。工具返回的失败不能证明内容不存在。回答时区分已确认的事实和不确定性，并使用用户的语言。"
COMPRESSION_MODEL=
MAX_ROUNDS=5
ROOT_DIR=D:\Course\Study\matt video
# 会话记录目录；留空时使用系统用户状态目录（Windows 为 %LOCALAPPDATA%\jarvis）
STATE_DIR=
RECENT_TASK_COUNT=5
TEXT_EXTENSIONS=.md,.txt,.json,.yaml,.yml,.toml,.py
REQUEST_TIMEOUT=60
MAX_READ_CHARS=12000
MAX_SEARCH_MATCHES=20
MAX_DIRECTORY_ENTRIES=200
MAX_TOOL_RESULT_TOKENS=8192
CONTEXT_WINDOW_TOKENS=
MODEL_CAPABILITIES_FILE=
MAX_OUTPUT_TOKENS=32768
COMPRESSION_CONTEXT_WINDOW_TOKENS=
COMPRESSION_MAX_OUTPUT_TOKENS=
# 预留（token）：压缩触发线与发送上限共用这个值，输出上限按剩余空间收敛。
CONTEXT_RESERVE_TOKENS=16384
CONTEXT_KEEP_RECENT_TOKENS=20000
CONTEXT_COMPACTION_FAILURE_LIMIT=3
CONTEXT_SUMMARY_MAX_CHARS=6000
TOOL_OUTPUT_PREVIEW_CHARS=500
VERBOSE_TOOL_OUTPUT=false
# approve-all: 每次确认；approve-dangerous: 高风险确认；broad-access: 显式宽授权。
TOOL_PERMISSION_MODE=approve-dangerous
TOOL_MAX_TIMEOUT=60
# native 需要通过 Agent(native_loader=...) 提供供应商适配器；通用客户端使用 emulated。
PROVIDER_TOOL_MODE=emulated
# Optional: leave all four blank for keyword-only memory. No provider is selected by default.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
