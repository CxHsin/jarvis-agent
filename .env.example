# OpenAI-compatible Chat Completions endpoint.
BASE_URL=https://api.openai.com/v1
API_KEY=
MODEL=
COMPRESSION_MODEL=
MAX_ROUNDS=5
ROOT_DIR=D:\Course\Study\matt video
# 会话记录目录；留空时使用系统用户状态目录（Windows 为 %LOCALAPPDATA%\jarvis）
STATE_DIR=
TEXT_EXTENSIONS=.md,.txt,.json,.yaml,.yml,.toml,.py
REQUEST_TIMEOUT=60
MAX_READ_CHARS=12000
MAX_SEARCH_MATCHES=20
CONTEXT_WINDOW_TOKENS=
MODEL_CAPABILITIES_FILE=
MAX_OUTPUT_TOKENS=32768
COMPRESSION_CONTEXT_WINDOW_TOKENS=
COMPRESSION_MAX_OUTPUT_TOKENS=
CONTEXT_SAFETY_MARGIN=0.02
CONTEXT_COMPRESSION_THRESHOLD=0.90
# 扁平预留（token）；设置后触发线与发送上限重合，输出上限按剩余空间收敛。留空时沿用上面两项折算。
CONTEXT_RESERVE_TOKENS=
CONTEXT_KEEP_RECENT_TOKENS=20000
CONTEXT_COMPACTION_FAILURE_LIMIT=3
CONTEXT_SUMMARY_MAX_CHARS=6000
TOOL_OUTPUT_PREVIEW_CHARS=500
VERBOSE_TOOL_OUTPUT=false
